# Local Compose uses the memory adapter and does not require Supabase credentials.
AUTH_MODE=memory
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4321

# Production API: use a server-only secret key. Never put these in frontend PUBLIC_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-auth-verification-key
SUPABASE_SECRET_KEY=replace-with-server-only-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key # Legacy alternative

# Split frontend hosting, for example Vercel -> VPS API.
PUBLIC_API_BASE_URL=
